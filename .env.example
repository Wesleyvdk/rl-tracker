BOT_TOKEN=
CLIENTID=
# Optional: register only to a test server. Otherwise commands are global.
# TEST_GUILD_ID=
# Docker sets these automatically. For direct host execution, set appropriate paths.
# DATABASE_PATH=/app/data/database.sqlite
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# SCRAPE_COOLDOWN_MS=4000
# BACKUP_DIR=backups
# Optional: local, read-only organization/server theme bindings. See docs/themes.md.
# ORGANIZATION_THEMES_PATH=/run/rl-themes/organizations.json

# Optional: preserve a locally verified browser image during upgrades.
# RL_TRACKER_BASE_IMAGE=rl-tracker:before-local-restoration-20261015

# Optional local organization theme editor. Add the exact /oauth/callback URL to
# Discord OAuth2 Redirects. Only /identify sign-in is requested; no user token is stored.
# CLIENTSECRET=
# THEME_EDITOR_BASE_URL=https://trackerbot.aylian-studios.com
# THEME_EDITOR_PORT=8790
# THEME_EDITOR_HOST=0.0.0.0
